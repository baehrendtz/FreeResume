  lang="en"
>
  <Navbar lang="en" />
  <main>
    <Hero lang="en" />
    <TrustBadges lang="en" />
    <Steps lang="en" />
    <WhyFree lang="en" />
    <LinkedInGap lang="en" />
    <Templates lang="en" />
    <SearchableText lang="en" />
    <FAQ lang="en" />
    <Why lang="en" />
    <FinalCTA lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
