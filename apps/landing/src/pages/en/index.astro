---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import Steps from '../../components/Steps.astro';
import WhyFree from '../../components/WhyFree.astro';
import LinkedInGap from '../../components/LinkedInGap.astro';
import Templates from '../../components/Templates.astro';
import SearchableText from '../../components/SearchableText.astro';
import FAQ from '../../components/FAQ.astro';
import Why from '../../components/Why.astro';
import FinalCTA from '../../components/FinalCTA.astro';
