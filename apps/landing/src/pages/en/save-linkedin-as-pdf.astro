---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { appUrl, paths } from '../../links';

const linkedInProfileUrl = 'https://www.linkedin.com/in/me/';

const steps = [
  {
    title: 'Open your profile on a computer',
    body: 'Sign in to LinkedIn in a desktop browser and go to your own profile. The export is not available in the mobile app.',
  },
  {
    title: 'Click Resources below your name',
    body: 'The button sits in the profile header, next to Open to and Add profile section. On some accounts it is still called More.',
  },
  {
    title: 'Choose Save to PDF',
    body: 'The file downloads right away. It is usually called Profile.pdf and lands in your Downloads folder.',
  },
  {
    title: 'Upload the file to Free Resume',
    body: 'Drop the PDF into the tool. Jobs, education, skills and languages fill in automatically. Then pick a template and download your CV.',
  },
];

const troubleshooting = [
  'No button called Resources? Look for More, the older name is still used on some accounts.',
  'Use LinkedIn in a desktop browser. The mobile app has no Save to PDF option.',
  'If the option is missing, temporarily switching LinkedIn to English and reloading your profile can help.',
  'If it still does not appear, you can start from scratch in Free Resume and type the details yourself.',
];

const faq = [
  {
    q: 'Does saving my profile as a PDF cost anything?',
    a: 'No, the feature is part of LinkedIn and needs no premium account.',
  },
  {
    q: 'Can I save someone else’s profile as a PDF?',
    a: 'Yes, the same menu appears on other profiles. LinkedIn does limit how many profiles you can save per month.',
  },
  {
    q: 'Does the export work in other languages?',
    a: 'Yes. LinkedIn’s help page notes that profiles may need to be in English, but in practice it usually works anyway. Free Resume reads both English and Swedish profiles.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Free Resume", "item": "https://freeresume.eu/en/" },
        { "@type": "ListItem", "position": 2, "name": "Save LinkedIn as PDF", "item": "https://freeresume.eu/en/save-linkedin-as-pdf/" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a },
      })),
    },
  ],
};
---

<BaseLayout
  title="Save your LinkedIn profile as a PDF: step by step"
  description="How to download your LinkedIn profile as a PDF on a computer, what the file is called and what to do when Save to PDF is missing. Then turn it into a free CV."
  lang="en"
  altPath="/spara-linkedin-som-pdf/"
>
  <Navbar lang="en" />

  <main class="pt-28 pb-16 sm:pt-32">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-500 dark:text-gray-400">
        <a href={paths.en.home} class="hover:underline">Free Resume</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>Save LinkedIn as PDF</span>
      </nav>

      <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white text-balance">
        How to save your LinkedIn profile as a PDF
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        LinkedIn can save your whole profile as a PDF. That file is the starting point when you build a CV in
        Free Resume. Here are the steps, and what to do when the button is missing.
      </p>

      <a
        href={linkedInProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 px-4 py-2.5 font-semibold text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
      >
        Open your LinkedIn profile
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>

      <ol class="mt-10 space-y-8">
        {steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white font-semibold">{i + 1}</span>
            <div>
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white">{step.title}</h2>
              <p class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="mt-14 text-2xl font-bold text-gray-900 dark:text-white">Cannot find the button?</h2>
      <ul class="mt-4 space-y-2.5">
        {troubleshooting.map((item) => (
          <li class="flex gap-2.5 text-gray-600 dark:text-gray-400 leading-relaxed">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-600 dark:bg-brand-400" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>

      <h2 class="mt-14 text-2xl font-bold text-gray-900 dark:text-white">What LinkedIn's PDF contains</h2>
      <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
        The PDF is a printout of your profile: headline, summary, every job, education, skills and languages.
        It also carries LinkedIn's own layout and often runs to four pages or more. Free Resume reads the content
        and rebuilds it into a one or two page CV where you choose what to show.
      </p>

      <div class="mt-10 rounded-2xl bg-gray-50 dark:bg-gray-900 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Next step: build the CV</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Upload the PDF and everything fills in automatically. Free, no account, and the file stays in your browser.
        </p>
        <div class="mt-5 flex flex-col sm:flex-row gap-3">
          <a href={appUrl('en')} class="inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Upload your LinkedIn PDF
          </a>
          <a href={paths.en.templates} class="inline-flex items-center justify-center px-5 py-3 rounded-lg font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            See the CV templates
          </a>
        </div>
      </div>

      <h2 class="mt-14 text-2xl font-bold text-gray-900 dark:text-white">Frequently asked questions</h2>
      <dl class="mt-4 divide-y divide-gray-200 dark:divide-gray-800">
        {faq.map((item) => (
          <div class="py-5">
            <dt class="font-semibold text-gray-900 dark:text-white">{item.q}</dt>
            <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed">{item.a}</dd>
          </div>
        ))}
      </dl>
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Footer lang="en" />
</BaseLayout>
