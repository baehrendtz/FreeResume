---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Templates from '../components/Templates.astro';
import Footer from '../components/Footer.astro';
import { appUrl, paths } from '../links';

const choose = [
  { name: 'Klassisk', body: 'Passar de flesta jobb, särskilt inom offentlig sektor, ekonomi och teknik, där innehållet ska fram utan krusiduller.' },
  { name: 'Professionell', body: 'Mörkt sidhuvud och sidofält. Bra när du har många år bakom dig och vill lyfta kontaktuppgifter och kompetenser.' },
  { name: 'Modern', body: 'Sidofält med plats för foto. Välj den när du vill ha ett ansikte på CV:t och ett luftigare intryck.' },
  { name: 'Kreativ', body: 'Färgstark med sidofält, för roller inom design, marknad och kommunikation där uttryck räknas.' },
];

const readable = [
  'En kolumn, så att både människa och system läser innehållet i rätt ordning.',
  'Vanliga rubriker som Erfarenhet, Utbildning och Kompetenser.',
  'Tydliga datum på varje rad, så att din tidslinje går att följa.',
  'Riktig text i PDF:en i stället för en bild, så att innehållet går att söka i.',
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Free Resume", "item": "https://freeresume.eu/" },
    { "@type": "ListItem", "position": 2, "name": "CV-mallar", "item": "https://freeresume.eu/cv-mallar/" },
  ],
};
---

<BaseLayout
  title="Gratis CV-mallar som är enkla att läsa"
  description="Fyra gratis CV-mallar i en kolumn med vanliga rubriker. Fyll i från din LinkedIn-profil och ladda ner som PDF, utan konto och utan betalvägg."
  lang="sv"
  altPath="/en/cv-templates/"
>
  <Navbar lang="sv" />

  <main class="pt-28 sm:pt-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Brödsmulor" class="text-sm text-gray-500 dark:text-gray-400">
        <a href={paths.sv.home} class="hover:underline">Free Resume</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>CV-mallar</span>
      </nav>
      <h1 class="mt-4 max-w-3xl text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white text-balance">
        Gratis CV-mallar
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Fyra mallar gjorda för att läsas, både av rekryteraren som skummar och av systemet som läser text.
        Alla är gratis, du behöver inget konto, och du kan byta mall när som helst utan att skriva om något.
      </p>
    </div>

    <Templates lang="sv" detailed />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Vilken mall ska jag välja?</h2>
      <dl class="mt-4 divide-y divide-gray-200 dark:divide-gray-800">
        {choose.map((item) => (
          <div class="py-4">
            <dt class="font-semibold text-gray-900 dark:text-white">{item.name}</dt>
            <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed">{item.body}</dd>
          </div>
        ))}
      </dl>

      <h2 class="mt-12 text-2xl font-bold text-gray-900 dark:text-white">Vad gör en mall lätt att läsa?</h2>
      <ul class="mt-4 space-y-2.5">
        {readable.map((item) => (
          <li class="flex gap-2.5 text-gray-600 dark:text-gray-400 leading-relaxed">
            <svg class="w-5 h-5 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-12 rounded-2xl bg-gray-50 dark:bg-gray-900 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Fyll mallen med din LinkedIn-profil</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Ladda upp din LinkedIn-PDF så fylls jobb, utbildning och kompetenser i automatiskt.
        </p>
        <div class="mt-5 flex flex-col sm:flex-row gap-3">
          <a href={appUrl('sv')} class="inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Skapa ditt CV gratis
          </a>
          <a href={paths.sv.guide} class="inline-flex items-center justify-center px-5 py-3 rounded-lg font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            Så sparar du LinkedIn som PDF
          </a>
        </div>
      </div>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Footer lang="sv" />
</BaseLayout>
