---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import Steps from '../components/Steps.astro';
import WhyFree from '../components/WhyFree.astro';
import LinkedInGap from '../components/LinkedInGap.astro';
import Templates from '../components/Templates.astro';
import SearchableText from '../components/SearchableText.astro';
import FAQ from '../components/FAQ.astro';
import Why from '../components/Why.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gratis CV från LinkedIn: gör ditt CV på en minut"
  description="Ladda upp din LinkedIn-PDF och få ett gratis CV direkt. Fyra mallar, sökbar PDF, inget konto och ingen betalvägg. Allt sker i din webbläsare."
  lang="sv"
>
  <Navbar lang="sv" />
  <main>
    <Hero lang="sv" />
    <TrustBadges lang="sv" />
    <Steps lang="sv" />
    <WhyFree lang="sv" />
    <LinkedInGap lang="sv" />
    <Templates lang="sv" />
    <SearchableText lang="sv" />
    <FAQ lang="sv" />
    <Why lang="sv" />
    <FinalCTA lang="sv" />
  </main>
  <Footer lang="sv" />
</BaseLayout>
