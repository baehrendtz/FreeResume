---
import type { Lang } from '../types';
import { appUrl, paths } from '../links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = {
  sv: {
    headline: 'Gör ett CV av din LinkedIn-profil, gratis',
    subtitle: 'Ladda upp din LinkedIn-PDF och få ett färdigt CV på en minut. Ingen inloggning, ingen betalvägg, och filen lämnar aldrig din webbläsare.',
    cta: 'Ladda upp din LinkedIn-PDF',
    secondary: 'Så sparar du PDF:en',
    proofs: ['Gratis, även nedladdningen', 'Inget konto', 'Allt sker i din webbläsare'],
    imgAlt: 'Free Resume visar tre steg: öppna LinkedIn-profilen, välj Spara som PDF och ladda upp filen',
  },
  en: {
    headline: 'Turn your LinkedIn profile into a resume, free',
    subtitle: 'Upload your LinkedIn PDF and get a finished CV in a minute. No sign-up, no paywall, and the file never leaves your browser.',
    cta: 'Upload your LinkedIn PDF',
    secondary: 'How to save the PDF',
    proofs: ['Free, including the download', 'No account', 'Everything runs in your browser'],
    imgAlt: 'Free Resume showing three steps: open your LinkedIn profile, choose Save to PDF and upload the file',
  },
}[lang];
---

<section class="pt-28 pb-10 sm:pt-32 sm:pb-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white text-balance">
          {t.headline}
        </h1>

        <p class="mt-5 text-lg text-gray-600 dark:text-gray-300 max-w-xl mx-auto lg:mx-0">
          {t.subtitle}
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-3">
          <a
            href={appUrl(lang)}
            class="inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 text-white font-semibold px-7 py-3.5 rounded-lg transition-colors"
          >
            {t.cta}
          </a>
          <a
            href={paths[lang].guide}
            class="inline-flex items-center justify-center px-5 py-3.5 rounded-lg font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
          >
            {t.secondary}
          </a>
        </div>

        <ul class="mt-6 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
          {t.proofs.map((item) => (
            <li class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative">
        <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200 dark:border-gray-700">
          <img
            src="/app-screenshot.webp"
            alt={t.imgAlt}
            width="1440"
            height="900"
            class="w-full h-auto"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
