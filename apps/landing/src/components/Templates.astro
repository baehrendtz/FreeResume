---
import type { Lang } from '../types';
import { appUrl, paths } from '../links';

interface Props {
  lang: Lang;
  /** Long version is used on the templates page, short on the start page. */
  detailed?: boolean;
}

const { lang, detailed = false } = Astro.props;

const t = {
  sv: {
    heading: 'CV-mallar som är enkla att läsa',
    subtitle: 'Fyra mallar, alla i en kolumn med vanliga rubriker. Byt mall när som helst, innehållet följer med.',
    cta: 'Se alla CV-mallar',
    ctaApp: 'Prova mallarna gratis',
    templates: [
      { name: 'Klassisk', img: '/template-basic.webp', desc: 'En kolumn, ren och tidlös. Fungerar till de flesta jobb.', alt: 'CV-mallen Klassisk, en kolumn med tydliga rubriker' },
      { name: 'Professionell', img: '/template-professional.webp', desc: 'Mörkt sidhuvud och sidofält för kontakt och kompetenser.', alt: 'CV-mallen Professionell, mörkt sidhuvud och sidofält' },
      { name: 'Modern', img: '/template-modern.webp', desc: 'Sidofält med plats för foto, luftig och lätt att skumma.', alt: 'CV-mallen Modern, sidofält med foto' },
      { name: 'Kreativ', img: '/template-creative.webp', desc: 'Färgstark med sidofält, för roller där uttryck räknas.', alt: 'CV-mallen Kreativ, färgstark med sidofält' },
    ],
  },
  en: {
    heading: 'CV templates that are easy to read',
    subtitle: 'Four templates, all single column with standard headings. Switch template at any time, your content follows.',
    cta: 'See all CV templates',
    ctaApp: 'Try the templates for free',
    templates: [
      { name: 'Classic', img: '/template-basic.webp', desc: 'One column, clean and timeless. Works for most jobs.', alt: 'The Classic CV template, one column with clear headings' },
      { name: 'Professional', img: '/template-professional.webp', desc: 'Dark header and a sidebar for contact details and skills.', alt: 'The Professional CV template, dark header and sidebar' },
      { name: 'Modern', img: '/template-modern.webp', desc: 'Sidebar with room for a photo, airy and easy to scan.', alt: 'The Modern CV template, sidebar with a photo' },
      { name: 'Creative', img: '/template-creative.webp', desc: 'Colorful with a sidebar, for roles where expression counts.', alt: 'The Creative CV template, colorful with a sidebar' },
    ],
  },
}[lang];
---

<section class="py-14 sm:py-20" id="templates">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white text-balance">{t.heading}</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">{t.subtitle}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {t.templates.map((tpl) => (
        <div>
          <a href={appUrl(lang)} class="group block">
            <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm group-hover:shadow-lg transition-shadow bg-white">
              <img
                src={tpl.img}
                alt={tpl.alt}
                width="736"
                height="1041"
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
          <h3 class="mt-3 font-semibold text-gray-900 dark:text-white">{tpl.name}</h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{tpl.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
      {detailed ? (
        <a href={appUrl(lang)} class="inline-flex items-center bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
          {t.ctaApp}
        </a>
      ) : (
        <a href={paths[lang].templates} class="font-semibold text-brand-600 dark:text-brand-400 hover:underline">
          {t.cta}
        </a>
      )}
    </div>
  </div>
</section>
