---
import type { Lang } from '../types';
import { paths } from '../links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = {
  sv: {
    heading: 'Så gör du, tre steg',
    guideLink: 'Detaljerad guide med bilder',
    steps: [
      {
        title: 'Spara din LinkedIn-profil som PDF',
        desc: 'Öppna profilen i en webbläsare på datorn, klicka på Resurser (eller Mer) under ditt namn och välj Spara som PDF.',
      },
      {
        title: 'Ladda upp PDF:en',
        desc: 'Dra in filen i Free Resume. Jobb, utbildning, kompetenser och språk fylls i automatiskt.',
      },
      {
        title: 'Ladda ner ditt CV',
        desc: 'Välj mall, justera texterna om du vill och ladda ner en PDF med sökbar text.',
      },
    ],
  },
  en: {
    heading: 'How it works, three steps',
    guideLink: 'Step by step guide with pictures',
    steps: [
      {
        title: 'Save your LinkedIn profile as a PDF',
        desc: 'Open your profile in a desktop browser, click Resources (or More) below your name and choose Save to PDF.',
      },
      {
        title: 'Upload the PDF',
        desc: 'Drop the file into Free Resume. Jobs, education, skills and languages fill in automatically.',
      },
      {
        title: 'Download your CV',
        desc: 'Pick a template, adjust the text if you want and download a PDF with searchable text.',
      },
    ],
  },
}[lang];
---

<section class="py-14 sm:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white text-center">
      {t.heading}
    </h2>

    <ol class="mt-10 space-y-8">
      {t.steps.map((step, i) => (
        <li class="flex gap-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white font-semibold">
            {i + 1}
          </span>
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{step.title}</h3>
            <p class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed">{step.desc}</p>
            {i === 0 && (
              <a
                href={paths[lang].guide}
                class="mt-2 inline-block text-sm font-semibold text-brand-600 dark:text-brand-400 hover:underline"
              >
                {t.guideLink}
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
