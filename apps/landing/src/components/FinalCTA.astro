---
import type { Lang } from '../types';
import { appUrl, paths } from '../links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = {
  sv: {
    heading: 'Redo att göra ditt CV?',
    subtitle: 'Ladda upp din LinkedIn-PDF och ladda ner ett färdigt CV. Gratis, utan konto.',
    cta: 'Ladda upp din LinkedIn-PDF',
    secondary: 'Läs guiden först',
  },
  en: {
    heading: 'Ready to build your CV?',
    subtitle: 'Upload your LinkedIn PDF and download a finished CV. Free, no account.',
    cta: 'Upload your LinkedIn PDF',
    secondary: 'Read the guide first',
  },
}[lang];
---

<section class="py-14 sm:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">{t.heading}</h2>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">{t.subtitle}</p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={appUrl(lang)}
        class="inline-flex items-center justify-center bg-brand-600 hover:bg-brand-700 text-white font-semibold px-7 py-3.5 rounded-lg transition-colors"
      >
        {t.cta}
      </a>
      <a
        href={paths[lang].guide}
        class="inline-flex items-center justify-center px-5 py-3.5 rounded-lg font-semibold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
      >
        {t.secondary}
      </a>
    </div>
  </div>
</section>
