---
import { BRAND } from "@freeresume/shared/brand";
import CookieConsent from "../components/CookieConsent.astro";
import type { Lang } from "../types";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path of the same page in the other language, defaults to the start pages. */
  altPath?: string;
  /** Keep the page out of search results, used for the 404 page. */
  noindex?: boolean;
}

const { title, description, lang, altPath, noindex = false } = Astro.props;

const site = Astro.site ?? new URL(BRAND.site);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site).href;
const locale = lang === 'sv' ? 'sv_SE' : 'en_US';
const altLocale = lang === 'sv' ? 'en_US' : 'sv_SE';
const altURL = new URL(altPath ?? (lang === 'sv' ? '/en/' : '/'), site).href;
// x-default points at the Swedish start page, in the same form as its canonical
const defaultURL = new URL('/', site).href;

const organization = {
  "@type": "Organization",
  "@id": `${site.origin}/#organization`,
  "name": BRAND.name,
  "url": `${site.origin}/`,
  "logo": `${site.origin}/logo.png`,
  "sameAs": ["https://github.com/baehrendtz/FreeResume"],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      "url": `${site.origin}/`,
      "name": BRAND.name,
      "inLanguage": lang,
      "publisher": { "@id": organization["@id"] },
    },
    {
      "@type": "WebApplication",
      "@id": `${site.origin}/#app`,
      "name": BRAND.name,
      "url": `https://${BRAND.domains.app}/${lang}`,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web browser",
      "browserRequirements": "Requires JavaScript",
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": lang === 'sv' ? 'SEK' : 'EUR',
      },
      "publisher": { "@id": organization["@id"] },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={BRAND.themeColor} />
    <script is:inline>
      (function() {
        function getCookie(n){var m=document.cookie.match('(^|; )'+n+'=([^;]*)');return m?m[2]:null}
        function setCookie(n,v){document.cookie=n+'='+v+';domain=.freeresume.eu;path=/;max-age=31536000;SameSite=Lax'}
        var saved = localStorage.getItem('theme') || getCookie('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = saved === 'dark' || (!saved && prefersDark.matches);
        if (isDark) document.documentElement.classList.add('dark');
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', isDark ? '#030712' : '#2563eb');
        prefersDark.addEventListener('change', function(e) {
          if (localStorage.getItem('theme')) return;
          document.documentElement.classList.toggle('dark', e.matches);
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', e.matches ? '#030712' : '#2563eb');
        });
        document.addEventListener('click', function(e) {
          if (!e.target.closest('#theme-toggle')) return;
          var dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          setCookie('theme', dark ? 'dark' : 'light');
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#030712' : '#2563eb');
        });
      })();
    </script>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={lang} href={canonicalURL.href} />
    <link rel="alternate" hreflang={lang === 'sv' ? 'en' : 'sv'} href={altURL} />
    <link rel="alternate" hreflang="x-default" href={defaultURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'sv' ? 'Free Resume: gratis CV från din LinkedIn-profil' : 'Free Resume: a free CV from your LinkedIn profile'} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={altLocale} />
    <meta property="og:site_name" content={BRAND.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 font-['Inter',sans-serif] antialiased">
    <slot />
    <CookieConsent lang={lang} />
  </body>
</html>
